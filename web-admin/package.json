{
  "name": "mcpserver-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Admin SPA for mcpserver-r. Built artifacts land in inst/admin-ui/dist/ and are served by the R process.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync": "node tools/sync-to-inst.mjs",
    "build-and-sync": "npm run build && npm run sync",
    "e2e:setup": "playwright install --with-deps chromium",
    "e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.0",
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-compression": "^0.5.1"
  }
}
